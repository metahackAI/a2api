{
  "a2api": "0.1.0-draft.1",
  "id": "order.shipping_status",
  "version": "0.1.0",
  "lifecycle": "draft",
  "enabled": false,
  "title": "주문 배송 현황 조회",
  "owner": "demo-order-team",
  "intent": {
    "summary": "주문과 연결된 최대 10개 배송의 현재 상태와 배송 예정 시각을 조회한다. 한도를 넘으면 전체 결과처럼 잘라내지 않고 지원 범위 초과를 보고한다.",
    "useWhen": ["주문 번호를 알고 연결된 배송이 10개 이하인 주문의 배송 상황을 확인하려는 경우"],
    "avoidWhen": ["주문 취소", "배송지 변경", "주문 번호 없이 고객 이름만으로 주문을 확정하려는 경우"]
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orderId": {
        "type": "string",
        "minLength": 1,
        "description": "조회 권한이 있는 주문의 번호",
        "x-a2api-semanticType": "sales.OrderId"
      }
    },
    "required": ["orderId"],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "orderId": {"type": "string", "x-a2api-semanticType": "sales.OrderId"},
      "orderState": {"type": "string", "enum": ["created", "processing", "shipped", "cancelled"]},
      "shipments": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "shipmentId": {"type": "string", "x-a2api-semanticType": "shipping.ShipmentId"},
            "status": {"type": "string", "enum": ["pending", "in_transit", "delivered", "exception"]},
            "estimatedArrival": {"type": ["string", "null"], "format": "date-time"},
            "asOf": {"type": "string", "format": "date-time"}
          },
          "required": ["shipmentId", "status", "estimatedArrival", "asOf"],
          "additionalProperties": false
        }
      }
    },
    "required": ["orderId", "orderState", "shipments"],
    "additionalProperties": false
  },
  "semanticTypes": {
    "sales.OrderId": {"baseType": "string", "namespace": "demo-sales"},
    "shipping.ShipmentId": {"baseType": "string", "namespace": "demo-shipping"}
  },
  "contextRequirements": ["actor", "tenant"],
  "effects": {
    "kind": "read",
    "externalWrites": false,
    "sensitiveData": ["order_status", "shipment_status"]
  },
  "policy": {
    "requiredScopes": ["orders:read", "shipments:read"],
    "objectAuthorization": "backend_and_runtime",
    "resourceRelationshipCheck": "shipment_belongs_to_authorized_order",
    "approval": "not_required_for_this_read"
  },
  "operations": [
    {
      "id": "demo.getOrder",
      "serviceRef": "demo-orders",
      "operationRef": "getOrder",
      "effects": {"kind": "read", "externalWrites": false},
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "orderId": {"type": "string", "minLength": 1, "x-a2api-semanticType": "sales.OrderId"}
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "orderId": {"type": "string", "x-a2api-semanticType": "sales.OrderId"},
          "orderState": {"type": "string", "enum": ["created", "processing", "shipped", "cancelled"]},
          "shipmentIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {"type": "string", "x-a2api-semanticType": "shipping.ShipmentId"}
          }
        },
        "required": ["orderId", "orderState", "shipmentIds"],
        "additionalProperties": false
      }
    },
    {
      "id": "demo.getShipment",
      "serviceRef": "demo-shipping",
      "operationRef": "getShipment",
      "effects": {"kind": "read", "externalWrites": false},
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "shipmentId": {"type": "string", "x-a2api-semanticType": "shipping.ShipmentId"}
        },
        "required": ["shipmentId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "shipmentId": {"type": "string", "x-a2api-semanticType": "shipping.ShipmentId"},
          "status": {"type": "string", "enum": ["pending", "in_transit", "delivered", "exception"]},
          "estimatedArrival": {"type": ["string", "null"], "format": "date-time"},
          "asOf": {"type": "string", "format": "date-time"}
        },
        "required": ["shipmentId", "status", "estimatedArrival", "asOf"],
        "additionalProperties": false
      }
    }
  ],
  "binding": {
    "type": "composition",
    "steps": [
      {
        "id": "order",
        "operationId": "demo.getOrder",
        "input": {"orderId": {"from": "input", "pointer": "/orderId"}}
      },
      {
        "id": "shipments",
        "operationId": "demo.getShipment",
        "dependsOn": ["order"],
        "foreach": {"from": "step", "step": "order", "pointer": "/shipmentIds"},
        "maxItems": 10,
        "parallelism": 5,
        "emptyCollection": "succeed",
        "input": {"shipmentId": {"from": "item", "pointer": ""}}
      }
    ],
    "output": {
      "orderId": {"from": "step", "step": "order", "pointer": "/orderId"},
      "orderState": {"from": "step", "step": "order", "pointer": "/orderState"},
      "shipments": {"from": "step", "step": "shipments", "pointer": ""}
    }
  },
  "execution": {
    "mode": "synchronous",
    "deadlineMs": 5000,
    "backendTimeoutMs": 1500,
    "maxBackendCalls": 11,
    "maxRetries": 0,
    "failureMode": "stop",
    "successCondition": "all_required_steps_succeeded_and_output_valid"
  },
  "errors": [
    "INPUT_REQUIRED",
    "PERMISSION_DENIED",
    "PRECONDITION_FAILED",
    "SCHEMA_MISMATCH",
    "CONTRACT_DRIFT",
    "RATE_LIMITED",
    "DEADLINE_EXCEEDED"
  ],
  "presentation": {
    "view": "table",
    "rows": "/shipments",
    "contextFields": ["/orderId", "/orderState"],
    "columns": [
      {"pointer": "/shipmentId", "label": "배송 번호"},
      {"pointer": "/status", "label": "배송 상태"},
      {"pointer": "/estimatedArrival", "label": "예상 도착", "format": "datetime"},
      {"pointer": "/asOf", "label": "조회 기준 시각", "format": "datetime"}
    ],
    "timeZone": "Asia/Seoul",
    "emptyMessage": "이 주문에 연결된 배송이 없습니다. 주문 상태를 함께 확인하세요.",
    "missingEstimateMessage": "예상 도착 시각이 아직 제공되지 않았습니다."
  },
  "examples": [
    {"userIntent": "ORD-1001 주문 배송 상황을 알려줘", "input": {"orderId": "ORD-1001"}},
    {"userIntent": "배송지를 바꿔줘", "expectedDecision": "do_not_select"}
  ],
  "provenance": {
    "kind": "illustrative",
    "reviewState": "unreviewed",
    "note": "전체가 가상 예시다. 실제 endpoint, credential, backend 보장, 소유자 검토에 연결되지 않았다. 활성화하거나 운영 호출에 사용하지 않는다."
  }
}
