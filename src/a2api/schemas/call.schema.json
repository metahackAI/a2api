{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2api:call:0.1",
  "title": "a2api-call/1.0 wire components; select a named $defs component",
  "$defs": {
    "problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "code"
      ],
      "additionalProperties": false
    },
    "descriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "effects": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "summary",
        "effects",
        "inputSchema",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "discover_request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "discover_response": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "catalogVersion": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "effects": {
                    "type": "object"
                  },
                  "matchedTerms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "version",
                  "title",
                  "summary",
                  "effects",
                  "matchedTerms"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "catalogVersion",
            "capabilities",
            "nextCursor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/problem"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "describe_request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "describe_response": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "catalogVersion": {
              "type": "string"
            },
            "capability": {
              "$ref": "#/$defs/descriptor"
            }
          },
          "required": [
            "catalogVersion",
            "capability"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/problem"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "invoke_request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "catalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "version",
        "catalogVersion",
        "input"
      ],
      "additionalProperties": false
    },
    "invoke_response": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/problem"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "catalogVersion": {
              "type": "string"
            },
            "executionId": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "itemIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operation": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "step",
                  "itemIndex",
                  "operation",
                  "source",
                  "observedAt"
                ],
                "additionalProperties": false
              }
            },
            "stats": {
              "type": "object",
              "properties": {
                "backendCalls": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "backendCalls"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/problem"
            },
            "completeness": {
              "type": "object",
              "properties": {
                "complete": {
                  "const": false
                }
              },
              "required": [
                "complete"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "error",
            "completeness"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "catalogVersion": {
              "type": "string"
            },
            "executionId": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "itemIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operation": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "step",
                  "itemIndex",
                  "operation",
                  "source",
                  "observedAt"
                ],
                "additionalProperties": false
              }
            },
            "stats": {
              "type": "object",
              "properties": {
                "backendCalls": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "backendCalls"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "succeeded"
            },
            "data": {},
            "completeness": {
              "type": "object",
              "properties": {
                "complete": {
                  "const": true
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "complete"
              ],
              "additionalProperties": false
            },
            "presentation": {
              "type": "object"
            },
            "httpStatus": {
              "type": "integer",
              "minimum": 200,
              "maximum": 299
            }
          },
          "required": [
            "status",
            "data",
            "completeness"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
